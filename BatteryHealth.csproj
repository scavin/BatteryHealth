<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>BatteryHealth</AssemblyName>
    <RootNamespace>BatteryHealth</RootNamespace>
    <Authors>Scavin</Authors>
    <Description>一个轻量的 Windows 电池健康查看器</Description>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/scavin/BatteryHealth</RepositoryUrl>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Resource Include="app.ico" />
  </ItemGroup>
</Project>
